{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "*.js",
    "*.mjs",
    "*.d.ts",
    "tools/verify.ts"
  ],
  "exclude": [
    "node_modules",
    "tools/oxlint"
  ]
}
