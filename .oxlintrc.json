{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./templates/shared/.oxlintrc.json"
  ],
  "ignorePatterns": [
    "templates/nextjs/**",
    "templates/expo/**",
    "templates/shared/tools/oxlint/**"
  ],
  "overrides": [
    {
      "files": [
        "scripts/oxlint/ast.ts"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": [
          "error",
          {
            "allowInTypeGuards": true
          }
        ]
      }
    }
  ]
}
